# Gateway image for GitHub Actions (rh-forge build of the ODH Konflux image).
#
# Derived from Dockerfile.konflux.gateway at v0.0.116-rhaiv.0. Same base
# images, packages, cargo features and runtime layout. Differences:
#   * the Rust toolchain is the same 1.92.0 GNU tarball the supervisor and CLI
#     images use (deploy/konflux/*/generic-fetcher.yaml), downloaded with a
#     sha256 check instead of the AppStream rust/cargo RPMs, so all three
#     binaries are built by one compiler regardless of UBI repo drift;
#   * the Z3 source tarball is downloaded from the URL pinned in
#     deploy/konflux/gateway/generic-fetcher.yaml and verified against the
#     same sha256, instead of being read from the Hermeto prefetch directory;
#   * cargo registry and target dir live in BuildKit cache mounts;
#   * `--locked` fails the build if Cargo.lock would need updating (Hermeto's
#     offline build enforces the same thing).
#
# Local build:
#   docker buildx build --platform linux/amd64 \
#     -f deploy/docker/Dockerfile.gha.gateway \
#     --build-arg OPENSHELL_VERSION=v0.0.116-rhaiv.0-forge.1 .

ARG RUST_VERSION=1.92.0

# ---------------------------------------------------------------------------
# Toolchain (source independent; cached across builds)
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:25a147defd01e19674714f55d17538c8dbe55d8c305fa157ecc3f9c8977b05b6 AS toolchain

ARG RUST_VERSION
ARG TARGETARCH
# sha256 of rust-${RUST_VERSION}-<triple>.tar.xz (deploy/konflux/*/generic-fetcher.yaml)
ARG RUST_SHA256_X86_64=d2ccef59dd9f7439f2c694948069f789a044dc1addcc0803613232af8f88ee0c
ARG RUST_SHA256_AARCH64=3e383f8b4fca710d0600d0c1de97b78281672be2cda6575ecbe1c183a12e3822

RUN dnf install -y --nodocs --setopt=install_weak_deps=0 \
        gcc gcc-c++ make cmake \
        openssl-devel git-core clang-devel xz \
        gcc-toolset-14 gcc-toolset-14-gcc-c++ \
    && dnf clean all

RUN RUST_ARCH=$(case "${TARGETARCH}" in amd64) echo x86_64;; arm64) echo aarch64;; *) echo "${TARGETARCH}";; esac) && \
    RUST_TRIPLE="${RUST_ARCH}-unknown-linux-gnu" && \
    case "${RUST_ARCH}" in \
        x86_64)  RUST_SHA256="${RUST_SHA256_X86_64}" ;; \
        aarch64) RUST_SHA256="${RUST_SHA256_AARCH64}" ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac && \
    curl -fsSL --retry 3 -o /tmp/rust.tar.xz \
        "https://static.rust-lang.org/dist/rust-${RUST_VERSION}-${RUST_TRIPLE}.tar.xz" && \
    echo "${RUST_SHA256}  /tmp/rust.tar.xz" | sha256sum -c - && \
    mkdir -p /tmp/rust-toolchain && \
    tar xJf /tmp/rust.tar.xz -C /tmp/rust-toolchain --strip-components=1 && \
    /tmp/rust-toolchain/install.sh --prefix=/usr/local && \
    rm -rf /tmp/rust-toolchain /tmp/rust.tar.xz

# gcc-toolset-14 provides the C++20 <format> header required by bundled Z3.
ENV PATH=/opt/rh/gcc-toolset-14/root/usr/bin:${PATH} \
    LD_LIBRARY_PATH=/opt/rh/gcc-toolset-14/root/usr/lib64:/opt/rh/gcc-toolset-14/root/usr/lib \
    CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

# z3-sys bundled build needs the Z3 source tree. URL and checksum from
# deploy/konflux/gateway/generic-fetcher.yaml.
ARG Z3_VERSION=4.16.0
ARG Z3_SHA256=c68c3e5e4810b16126b8cb4c47eee85c1ac3e24a81914c8e371b40de9dd33ac7
RUN curl -fsSL --retry 3 -o /tmp/z3-${Z3_VERSION}.tar.gz \
        "https://github.com/Z3Prover/z3/archive/refs/tags/z3-${Z3_VERSION}.tar.gz" \
    && echo "${Z3_SHA256}  /tmp/z3-${Z3_VERSION}.tar.gz" | sha256sum -c - \
    && mkdir -p /tmp/z3-src \
    && tar xzf /tmp/z3-${Z3_VERSION}.tar.gz -C /tmp/z3-src --strip-components=1 \
    && rm -f /tmp/z3-${Z3_VERSION}.tar.gz

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
FROM toolchain AS builder

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY .cargo/ .cargo/
COPY crates/ crates/
COPY proto/ proto/
COPY providers/ providers/

# Version stamped into the binary via openshell-core::VERSION; tag builds
# pass the git tag with the leading "v" stripped. Empty otherwise.
ARG OPENSHELL_VERSION=""

# The alias re-adds `in-tree-compute-drivers`, which a bare
# `--no-default-features` would drop, leaving a gateway with no compute driver.
RUN --mount=type=cache,target=/root/.cargo/registry,id=odh-openshell-gateway-registry \
    --mount=type=cache,target=/build/target,id=odh-openshell-gateway-target \
    VER="${OPENSHELL_VERSION#v}" \
    && if [ -n "$VER" ]; then export OPENSHELL_GIT_VERSION="$VER"; fi \
    && Z3_SYS_BUNDLED_DIR_OVERRIDE=/tmp/z3-src \
    cargo build --release --locked \
        --package openshell-gateway \
        --no-default-features \
        --features defaults-without-telemetry,bundled-z3 \
    && mkdir -p /build/output \
    && cp /build/target/release/openshell-gateway /build/output/

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:7fbeae18dc9476399f565e68255f602a3374ea8614ba3d14843565131a13ff93

RUN microdnf install -y --nodocs --setopt=install_weak_deps=0 ca-certificates \
    && microdnf clean all

COPY --from=builder --chmod=0555 \
    /build/output/openshell-gateway \
    /usr/local/bin/openshell-gateway

LABEL com.redhat.component="odh-openshell-gateway-container" \
      description="gRPC/HTTP control-plane server for OpenShell sandboxed AI agent runtimes" \
      summary="gRPC/HTTP control-plane server for OpenShell sandboxed AI agent runtimes" \
      name="rhoai/odh-openshell-gateway-rhel9" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="8080:http" \
      io.k8s.display-name="odh-openshell-gateway" \
      io.k8s.description="odh-openshell-gateway" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"

USER 1000:1000
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/openshell-gateway"]
CMD ["--bind-address", "0.0.0.0", "--port", "8080"]
